# Copy this file to .env and fill in values from your SAM environment.
# Never commit the real .env file or share your access token.

SAM_SERVER_URL=https://your-sam-server.example.com
SAM_ORGANIZATION_ID=your-organization-id
SAM_PROJECT_ID=your-test-project-id
SAM_ACCESS_TOKEN=your-personal-access-token
SAM_USE_SSL=true
